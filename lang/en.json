  "tools": {
    "sectionTag": "◈ 01 — Tools",
    "title": "Visual Processing Suite",
    "desc": "Each tool runs entirely in your browser. No uploads to servers, installations.",
    "pixel": {
      "name": "Pixel Sorter",
      "desc": "Sort pixels by brightness, hue or saturation along horizontal, vertical or diagonal axes. Classic glitch aesthetic."
    },
    "dither": {
      "name": "Dithering",
      "desc": "Apply classic dithering algorithms: Floyd-Steinberg, ordered, Atkinson and more. Retro pixel aesthetics."
    },
    "glitch": {
      "name": "Glitch FX",
      "desc": "RGB split, tearing, block corruption and scanlines. With presets and one-tap random."
    },
    "constellation": {
      "name": "Constellation",
      "desc": "Overlay generative star maps, technical diagrams and node networks over your images. Export at high resolution."
    },
    "ascii": {
      "name": "ASCII Canvas",
      "desc": "Transform images into creative ASCII art with custom character sets and effects."
    },
    "halftone": {
      "name": "Halftone",
      "desc": "Create halftone dot patterns, CMYK separations, and retro print effects."
    },
    "triangulation": {
      "name": "Triangulation",
      "desc": "Reconstruct images into a low-poly vector style using Delaunay triangulation."
    },
    "crt": {
      "name": "CRT Bend",
      "desc": "Emulate CRT screen curvature, scanlines, and circuit-bent signal distortion."
    },
    "flyer": {
      "name": "Flyer Forge",
      "desc": "Generate flyers for music events with automatic, well-designed compositions."
    },
    "pattern": {
      "name": "Pattern Generator",
      "desc": "Generate abstract patterns, geometric designs and organic structures using Perlin noise, Voronoi, flow fields and strange attractors."
    }
  },
